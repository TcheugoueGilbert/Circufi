# ── Server ──────────────────────────────────────────────
NODE_ENV=development          # "development" uses the fixed OTP 123456; use "production" when deployed
PORT=5000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000   # URL of the frontend (comma-free, exact origin)

# ── Firebase (Realtime Database) ────────────────────────
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the quotes and the literal \n sequences from the downloaded JSON key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ── Authentication ──────────────────────────────────────
# REQUIRED in production (the server refuses to sign tokens without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRATION=7d

# ── AI assistant (Ollama, optional) ─────────────────────
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT_MS=60000
