  "description": "Digital Osusu Backend - AI-Powered Trust Infrastructure for Cooperative Savings",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "seed": "ts-node -r dotenv/config src/scripts/seed.ts"
  },
  "keywords": [
