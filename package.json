{
  "name": "circufi-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "build:shared": "cd packages/shared && npm run build",
    "build:backend": "cd packages/backend && npm run build",
    "build:frontend": "cd packages/frontend && npm run build",
    "setup": "npm install && npm run setup:shared && npm run setup:backend && npm run setup:frontend",
    "setup:shared": "cd packages/shared && npm install",
    "setup:backend": "cd packages/backend && npm install",
    "setup:frontend": "cd packages/frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}